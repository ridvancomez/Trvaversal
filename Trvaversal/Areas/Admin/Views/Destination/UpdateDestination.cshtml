@{
    ViewData["Title"] = "UpdateDestination";
    Layout = "~/Views/Shared/_AdminPanelLayout.cshtml";
}
@model DataTransferObjectLayer.Concrete.DestinationDTO

<div class="card m-4">
    <div class="card-header">
        <h5 class="mb-0">Rota Düzenle</h5>
    </div>
    <div class="card-body">
        <form method="post" enctype="multipart/form-data">
            <input type="hidden" name="previousImageUrl" value="@Model.CoverImage" />
            <input type="hidden" name="id" value="@ViewBag.Id" />
            
            <div class="row mb-3">
                <label class="col-sm-2 col-form-label" for="basic-default-name">Başlık</label>
                <div class="col-sm-10">
                    <input type="text" class="form-control" asp-for="Title" id="basic-default-name" placeholder="Başlık" />
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-sm-2 col-form-label" for="basic-default-name">Şehir</label>
                <div class="col-sm-10">
                    <input type="text" class="form-control" asp-for="City" id="basic-default-name" placeholder="Şehir" />
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-sm-2 col-form-label" for="basic-default-name">Kaç Gün Gece</label>
                <div class="col-sm-10">
                    <input type="text" class="form-control" asp-for="DayNight" id="basic-default-name" placeholder="4 Gün 5 Gece" />
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-sm-2 col-form-label" for="basic-default-name">Ücret</label>
                <div class="col-sm-10">
                    <input type="number" class="form-control" asp-for="Price" id="basic-default-name" placeholder="100" />
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-sm-2 col-form-label" for="basic-default-name">Alt Başlık</label>
                <div class="col-sm-10">
                    <input type="text" class="form-control" asp-for="SubTitle" id="basic-default-name" placeholder="Alt Başlık" />
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-sm-2 col-form-label" for="basic-default-name">Kapasite</label>
                <div class="col-sm-10">
                    <input type="text" class="form-control" asp-for="Capacity" id="basic-default-name" placeholder="12" />
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-sm-2 col-form-label" for="basic-default-name">Durum</label>
                <div class="col-sm-10">
                    <input type="checkbox" asp-for="Status" id="basic-default-name" />
                </div>

                <label class="col-sm-2 col-form-label" for="basic-default-name">Popüler</label>
                <div class="col-sm-10">
                    <input type="checkbox" asp-for="Popular" id="basic-default-name" />
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-sm-2 col-form-label" for="basic-default-name">Kapak Fotoğrafı</label>
                <div class="col-sm-10">
                    <input type="file" class="form-control" asp-for="Image" id="basic-default-name" placeholder="Resim Seçin" />
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-sm-2 col-form-label" for="basic-default-name">Detaylar</label>
                <div class="col-sm-10">
                    <textarea class="form-control" asp-for="Details" id="basic-default-name" placeholder="Detaylar"></textarea>
                </div>
            </div>

            <div class="row justify-content-end">
                <div class="col-sm-10">
                    <button type="submit" class="btn btn-primary">Gönder</button>
                </div>
            </div>
        </form>
    </div>
</div>

