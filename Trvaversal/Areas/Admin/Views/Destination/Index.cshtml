@model List<EntityLayer.Concrete.Destination>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_AdminPanelLayout.cshtml";
}
<div class="card m-4">
    <div class="d-flex justify-content-between align-items-center mx-4">
    <h5 class="card-header px-0 mx-0">Rotalar Tablosu</h5>
    <a href="/Admin/Destination/AddDestination" class="btn btn-success d-block">Yeni Rota Ekle</a>
    </div>
    <div class="card-body">
        <div class="table-responsive text-nowrap">
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Şehir</th>
                        <th>Fiyat</th>
                        <th>Kapasite</th>
                        <th>Popülerite</th>
                        <th>Durum</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td> @item.Id </td>
                            <td> @item.City </td>
                            <td> @item.Price </td>
                            <td> @item.Capacity </td>
                            <td>
                                <span class="badge @(item.Popular == true ? "bg-label-success" : "bg-label-primary") me-1">@(item.Popular == true ? "Popüler" : "Popüler Değil")</span>
                            </td>

                            <td>
                                <span class="badge @(item.Status == true ? "bg-label-success" : "bg-label-primary") me-1">@(item.Status == true ? "Aktif" : "Aktif Değil")</span>
                            </td>
                            <td>
                                <div class="dropdown">
                                    <button type="button"
                                            class="btn p-0 dropdown-toggle hide-arrow"
                                            data-bs-toggle="dropdown">
                                        <i class="bx bx-dots-vertical-rounded"></i>
                                    </button>
                                    <div class="dropdown-menu">
                                        <a class="dropdown-item" href="/Admin/Destination/UpdateDestination/@item.Id"><i class="bx bx-edit-alt me-1"></i> Güncelle</a>
                                        <a class="dropdown-item" href="/Admin/Destination/DeleteDestination/@item.Id"><i class="bx bx-trash me-1"></i> Sil</a>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>
    </div>
</div>

