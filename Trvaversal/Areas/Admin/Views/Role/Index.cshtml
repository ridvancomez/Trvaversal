@model List<AppRole>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_AdminPanelLayout.cshtml";
    int count = 0;
}

<div class="card m-4">
    <div class="d-flex justify-content-between align-items-center mx-4">
        <h5 class="card-header px-0 mx-0">Rol Tablosu</h5>
        <div>

            <a href="/Admin/Role/AddRole" class="btn btn-success me-2">Yeni Rol Ekle</a>
            <a href="/Admin/Role/UserList" class="btn btn-primary">Kullanıcıları Listele</a>
        </div>
    </div>
    <div class="card-body">
        <div class="table-responsive text-nowrap">
            @if (Model.Count > 0)
            {
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Rol Adı</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            count++;
                            <tr>
                                <td> @count </td>
                                <td> @item.Name </td>
                                <td>
                                    <div class="dropdown">
                                        <button type="button"
                                                class="btn p-0 dropdown-toggle hide-arrow"
                                                data-bs-toggle="dropdown">
                                            <i class="bx bx-dots-vertical-rounded"></i>
                                        </button>
                                        <div class="dropdown-menu">
                                            <a class="dropdown-item" href="/Admin/Role/UpdateRole/@item.Id"><i class="bx bx-edit-alt me-1"></i> Güncelle</a>
                                            <a class="dropdown-item" href="/Admin/Role/DeleteRole/@item.Id"><i class="bx bx-trash me-1"></i> Sil</a>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }


                    </tbody>
                </table>
            }
            else
            {
                <a href="/Admin/Role/AddRole" class="alert alert-success d-block text-success">Rol işlemi bulunamadı. Yeni rol girişi için lütfen tıklayın</a>
            }
        </div>
    </div>
</div>

