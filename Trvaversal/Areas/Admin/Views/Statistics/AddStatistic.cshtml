@model EntityLayer.Concrete.Statistic
@{
    ViewData["Title"] = "AddStatistic";
    Layout = "~/Views/Shared/_AdminPanelLayout.cshtml";
}

<div class="card m-4">
    <div class="card-header">
        <h5 class="mb-0">Yeni Rota Ekle</h5>
    </div>
    <div class="card-body">
        <form method="post">
            <div class="row mb-3">
                <label class="col-sm-2 col-form-label" for="basic-default-name">Başlık</label>
                <div class="col-sm-10">
                    <input type="text" class="form-control" asp-for="Name" id="name" placeholder="Başlık" />
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-sm-2 col-form-label" for="basic-default-name">Değer</label>
                <div class="col-sm-10">
                    <input type="number" class="form-control" asp-for="Value" id="value" placeholder="Değer" />
                </div>
            </div>    

            <div class="row justify-content-end">
                <div class="col-sm-10">
                    <button type="submit" class="btn btn-primary">Gönder</button>
                </div>
            </div>
        </form>
    </div>
</div>

