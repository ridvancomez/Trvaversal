@model List<EntityLayer.Concrete.Statistic>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_AdminPanelLayout.cshtml";
}

<div class="card m-4">
    <div class="d-flex justify-content-between align-items-center mx-4">
        <h5 class="card-header px-0 mx-0">İstatistik Tablosu</h5>
        <a href="/Admin/Statistic/AddStatistic" class="btn btn-success d-block">Yeni İstatistik Ekle</a>
    </div>
    <div class="card-body">
        <div class="table-responsive text-nowrap">
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>İsim</th>
                        <th>Değer</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach(var item in Model)
                    {
                        <tr>
                            <td> @item.Id </td>
                            <td> @item.Name </td>
                            <td> @item.Value </td>
                            <td>
                                <div class="dropdown">
                                    <button type="button"
                                            class="btn p-0 dropdown-toggle hide-arrow"
                                            data-bs-toggle="dropdown">
                                        <i class="bx bx-dots-vertical-rounded"></i>
                                    </button>
                                    <div class="dropdown-menu">
                                        <a class="dropdown-item" href="/Admin/Statistics/UpdateStatistic/@item.Id"><i class="bx bx-edit-alt me-1"></i> Güncelle</a>
                                        <a class="dropdown-item" href="/Admin/Statistics/DeleteStatistic/@item.Id"><i class="bx bx-trash me-1"></i> Sil</a>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>
    </div>
</div>

