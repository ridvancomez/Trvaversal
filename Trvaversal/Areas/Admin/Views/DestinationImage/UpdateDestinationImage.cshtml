@model DataTransferObjectLayer.Concrete.DestinationDetailImageDTO
@{
    ViewData["Title"] = "UpdateDestinationImage";
    Layout = "~/Views/Shared/_AdminPanelLayout.cshtml";
}

<div class="card m-4">
    <div class="card-header">
        <h5 class="mb-0">Yeni Rota Resmi Ekle</h5>
    </div>
    <div class="card-body">
        <form method="post" enctype="multipart/form-data">
            <input type="hidden" name="id" value="@ViewBag.Id"/>
            <input type="hidden" name="previousImageUrl" value="@Model.ImagePath" />
            <div class="row mb-3">
                <label class="col-sm-2 col-form-label" for="basic-default-name">Rota</label>
                <div class="col-sm-10">
                    @Html.DropDownListFor(m => m.DestinationId, (List<SelectListItem>)ViewBag.DestinationListItem, "Rota Seç", new { @class = "form-control" })
                </div>
            </div>
            <div class="row mb-3">
                <label class="col-sm-2 col-form-label" for="basic-default-name">Rota</label>
                <div class="col-sm-10">
                    <input type="file" asp-for="Image" class="form-control" />
                </div>
            </div>
            <div class="row justify-content-end">
                <div class="col-sm-10">
                    <button type="submit" class="btn btn-primary">Gönder</button>
                </div>
            </div>
        </form>
    </div>
</div>

