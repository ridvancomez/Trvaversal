@model DataTransferObjectLayer.Concrete.MailRequestDTO
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_AdminPanelLayout.cshtml";
}

<div class="card m-4">
    <div class="card-header">
        <h5 class="mb-0">Yeni Rota Resmi Ekle</h5>
    </div>
    <div class="card-body">
        <form method="post">

            <div class="row mb-3">
                <label class="col-sm-2 col-form-label" for="basic-default-name">Alıcı Mail</label>
                <div class="col-sm-10">
                    <input type="text" asp-for="ReceiverMail" class="form-control" />
                </div>
            </div>
            <div class="row mb-3">
                <label class="col-sm-2 col-form-label" for="basic-default-name">Konu</label>
                <div class="col-sm-10">
                    <input type="text" asp-for="Subject" class="form-control" />
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-sm-2 col-form-label" for="basic-default-name">İçerik</label>
                <div class="col-sm-10">
                    <textarea class="form-control" asp-for="Body"></textarea>
                </div>
            </div>
            <div class="row justify-content-end">
                <div class="col-sm-10">
                    <button type="submit" class="btn btn-primary">Gönder</button>
                </div>
            </div>
        </form>
    </div>
</div>

