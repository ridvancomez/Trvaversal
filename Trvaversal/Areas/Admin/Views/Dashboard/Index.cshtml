
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_AdminPanelLayout.cshtml";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="row">
        <div class="col-12 mb-4 order-0">
            <div class="card">
                <div class="d-flex align-items-end row">
                    <div class="col-sm-7">
                        <div class="card-body">
                            <h5 class="card-title text-primary">
                                Tebrikler @ViewBag.Name 🎉
                            </h5>
                            <p class="mb-4">
                                Bugün Tur Sitesi'nde <span class="fw-bold">72%</span> daha fazla satış gerçekleştirdiniz. Profilinizi kontrol ederek gelişmeleri inceleyebilirsiniz.
                            </p>

                            <a href="/Home/Index" target="_blank" class="btn btn-sm btn-outline-primary">Siteye Git</a>
                        </div>
                    </div>
                    <div class="col-sm-5 text-center text-sm-left">
                        <div class="card-body pb-0 px-0 px-md-4">
                            <img src="~/sneat-1.0.0/assets/img/illustrations/man-with-laptop-light.png"
                                 height="140"
                                 alt="View Badge User"
                                 data-app-dark-img="illustrations/man-with-laptop-dark.png"
                                 data-app-light-img="illustrations/man-with-laptop-light.png" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4 col-md-4 order-1">
            <div class="row">
                
            </div>
        </div>

        <div class="col-12 col-md-8 col-lg-4 order-3 order-md-2">
            <div class="row">
                
                <!-- </div>
                <div class="row"> -->
                
            </div>
        </div>
    </div>
    <div class="row">
        
        @await Component.InvokeAsync("DashboardDestinationStatisticsComponent")
        
        @await Component.InvokeAsync("DashboardGuideComponent")

        @await Component.InvokeAsync("DashboardStatisticsComponent")

    </div>
</div>

