@model DataTransferObjectLayer.Concrete.UserEditDTO
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="card mb-4 p-3">
                <div class="card-header pb-0">
                    <h6>Profil Düzenleme Sayfası</h6>
                </div>
                <form method="post" enctype="multipart/form-data">
                    @Html.Label("Adınız")
                    <input type="text" asp-for="Name" class="form-control" />
                    <br />
                        @Html.Label("Soyadınız")
                    <input type="text" asp-for="Surname" class="form-control text-xs" />
                    <br />
                    @Html.Label("Kullanıcı Adınız")
                    <input type="text" asp-for="UserName" class="form-control text-xs" />
                    <br />
                    @Html.Label("E Postanız")
                    <input type="email" asp-for="Email" class="form-control text-xs" />
                    <br />
                    @Html.Label("Şifreniz")
                    <input type="text" asp-for="Password" class="form-control text-xs" />
                    <br />
                    @Html.Label("Şifre Tekrar")
                    <input type="text" asp-for="ConfirmPassword" class="form-control text-xs" />
                    <br />
                    <div class="form-group">
                    @Html.Label("Resim Yükle")
                    <input type="file" asp-for="Image" class="form-control" />
                    </div>

                    <button type="submit" class="btn btn-primary">Güncelle</button>

                </form>
            </div>
        </div>
    </div>
</div>
