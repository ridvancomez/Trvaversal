@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";
}
@model List<EntityLayer.Concrete.Destination>
<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="card mb-4">
                <div class="card-header pb-0">
                    <h6>Rota Tablosu</h6>
                </div>
                <div class="card-body px-0 pt-0 pb-2">
                    <div class="table-responsive p-0">
                        <table class="table align-items-center mb-0">
                            <thead>
                                <tr>
                                    <th class="text-uppercase text-secondary font-weight-bolder p-3 opacity-7">#</th>
                                    <th class="text-uppercase text-secondary font-weight-bolder p-3 opacity-7">Şehir</th>
                                    <th class="text-uppercase text-secondary font-weight-bolder p-3 opacity-7">Süre</th>
                                    <th class="text-uppercase text-secondary font-weight-bolder p-3 opacity-7">Kapasite</th>
                                    <th class="text-uppercase text-secondary font-weight-bolder p-3 opacity-7">Fiyat</th>
                                    <th class="text-uppercase text-secondary font-weight-bolder p-3 opacity-7">Detaylar</th>

                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class=" text-xs font-weight-bolder p-3">@item.Id</td>
                                        <td class=" text-xs font-weight-bolder p-3">@item.City</td>
                                        <td class=" text-xs font-weight-bolder p-3">@item.DayNigth</td>
                                        <td class=" text-xs font-weight-bolder p-3">@item.Capacity</td>
                                        <td class=" text-xs font-weight-bolder p-3">@item.Price</td>
                                        <td class=" text-xs font-weight-bolder p-3"><a class="btn btn-sm btn-outline-secondary">Detaylar</a></td>
                                    </tr>
                                }
                                
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

