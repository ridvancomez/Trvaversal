@model EntityLayer.Concrete.Destination
<!-- about breadcrumb -->
<section class="w3l-about-breadcrumb text-left">
    <div class="breadcrumb-bg breadcrumb-bg-about py-sm-5 py-4">
        <div class="container">
            <h2 class="title">@Model.Title</h2>
            <ul class="breadcrumbs-custom-path mt-2">
                <li><a href="/Home/Index">Anasayfa</a></li>
                <li><span class="fa fa-arrow-right mx-2" aria-hidden="true"></span><a href="/Destination/Index">Rotalar</a></li>
                <li class="active"><span class="fa fa-arrow-right mx-2" aria-hidden="true"></span>@Model.City</li>
            </ul>
        </div>
    </div>
</section>
<!-- //about breadcrumb -->
<!--/blog-->
<div class="py-5 w3l-homeblock1 text-center">
    <div class="container mt-md-3">
        <h3 class="blog-desc-big text-center mb-4">
            @Model.SubTitle
        </h3>
        <div class=" w-100">
            <div class="">
                <div class="author align-items-center mb-1">
                    <h5>@Model.Title</h5>
                </div>
                <ul class="blog-meta">
                    <li class="meta-item blog-lesson">
                        <span class="meta-value"> @Model.City</span>
                    </li>
                    <br />
                    <li class="meta-item blog-students">
                        <span class="meta-value"> Kontenjan: @Model.Capacity </span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
<section class="blog-post-main w3l-homeblock1">
    <!--/blog-post-->
    <div class="blog-content-inf pb-5">
        <div class="container pb-lg-4">
            <div class="single-post-image">
                <div class="post-content">
                    <img src="assets/images/banner2.jpg" class="radius-image img-fluid mb-5" alt="" />
                </div>
            </div>
            <div id="owl-demo1" class="owl-two owl-carousel owl-theme">

                @foreach (var item in ViewBag.PictureList)
                {
                    <div class="item">
                        <div class="subject-img w-100">
                            <img src="@item.ImagePath" style="aspect-ratio:2/1; object-fit:fill; width: 100%" class="img-fluid" />
                        </div>
                    </div>
                }



            </div>
            <div class="single-post-content">
                <p class="alphabet mb-4">
                    <span class="big-letter">@Model.Details.Substring(0, 1)</span>@Model.Details.Substring(1)

                </p>


                @await Component.InvokeAsync("CommentComponent", new { destinationId = Model.Id })
            </div>
        </div>
    </div>
    <!--//blog-post-->
</section>

