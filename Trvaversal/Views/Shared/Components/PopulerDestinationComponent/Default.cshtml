@using EntityLayer.Concrete
@model List<Destination>

<section class="w3l-grids-3 py-5">
    <div class="container py-md-5">
        <div class="title-content text-left mb-lg-5 mb-4">
            <h6 class="sub-title">Visit</h6>
            <h3 class="hny-title">Popüler Rotalar</h3>
        </div>
        <!--/row-grids-->
        <div class="row bottom-ab-grids">
            @foreach (var item in Model)
            {
                <div class="col-lg-6 subject-card mt-lg-0 mt-4 mb-4">
                    <div class="subject-card-header p-4">
                        <a href="/Destination/DestinationDetail/@item.Id" class="card_title p-lg-4d-block">
                            <div class="row align-items-center">
                                <div class="col-sm-5 subject-img">
                                    <img src="@item.CoverImage" class="img-fluid" alt="">
                                </div>
                                <div class="col-sm-7 subject-content mt-sm-0 mt-4">
                                    <h4>@item.Title</h4>
                                    <h5 style="color:#ff1654">@item.City</h5>
                                    <hr/>
                                    <p>@item.DayNigth</p>
                                    <div class="dst-btm">
                                        <h6 class=""> Fiyat: </h6>
                                        <span>$1650</span>
                                    </div>
                                    <p class="sub-para">@item.SubTitle</p>
                                </div>
                            </div>
                        </a>
                    </div>
                </div>
            }



        </div>
    </div>
</section>