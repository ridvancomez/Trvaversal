@{
    Layout = null;
}

<!DOCTYPE html>

<html lang="en"
      class="light-style layout-menu-fixed"
      dir="ltr"
      data-theme="theme-default"
      data-assets-path="~/sneat-1.0.0/assets/"
      data-template="vertical-menu-template-free">

@await Html.PartialAsync("/Areas/Admin/Views/AdminLayoutPartial/_HeadPartial.cshtml")

<body>
    <div class="layout-wrapper layout-content-navbar">
        <div class="layout-container">

            @await Html.PartialAsync("/Areas/Admin/Views/AdminLayoutPartial/_SideBarPartial.cshtml")

            <div class="layout-page">

                @await Component.InvokeAsync("AdminNavbarPartialComponent", new { area = "Admin" })

                <div class="content-wrapper">

                    @RenderBody()

                    @await Html.PartialAsync("/Areas/Admin/Views/AdminLayoutPartial/_FooterPartial.cshtml")

                    <div class="content-backdrop fade"></div>
                </div>
            </div>
        </div>
        <div class="layout-overlay layout-menu-toggle"></div>
    </div>
    @await Html.PartialAsync("/Areas/Admin/Views/AdminLayoutPartial/_ScriptPartial.cshtml")
</body>
</html>